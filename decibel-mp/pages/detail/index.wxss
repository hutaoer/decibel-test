.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
}

.summary {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.summary-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.time {
  font-size: 26rpx;
  color: #5f5e5a;
}

.tag {
  font-size: 24rpx;
  color: #185fa5;
  background: #e6f1fb;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
}

.summary-value {
  display: flex;
  align-items: baseline;
}

.leq {
  font-size: 76rpx;
  font-weight: 500;
  line-height: 1;
}

.unit {
  font-size: 26rpx;
  color: #888780;
  margin-left: 8rpx;
}

.level {
  font-size: 28rpx;
  margin-left: 20rpx;
}

.summary-desc {
  display: block;
  font-size: 24rpx;
  color: #888780;
  margin-top: 12rpx;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: #888780;
}

.chart {
  width: 100%;
  height: 320rpx;
  margin-top: 12rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.stat {
  width: calc(50% - 12rpx);
  margin: 6rpx;
  background: #f1efe8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #888780;
  margin-bottom: 4rpx;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.warn {
  background: #fcebeb;
  color: #791f1f;
  font-size: 24rpx;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 16rpx;
}

.notice {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.notice-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.notice-text {
  display: block;
  font-size: 22rpx;
  color: #5f5e5a;
  line-height: 1.6;
}

.actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

button.btn {
  padding: 0;
  line-height: 88rpx;
  font-size: 30rpx;
}

button.btn::after {
  border: none;
}

.btn-half {
  width: 48%;
  margin-bottom: 16rpx;
}

.btn-block {
  width: 100%;
}

.btn-danger {
  color: #a32d2d;
  border-color: #e24b4a;
}
