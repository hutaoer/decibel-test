.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
}

.calib {
  font-size: 24rpx;
  color: #888780;
  padding: 8rpx 16rpx;
  border: 1rpx solid #d3d1c7;
  border-radius: 24rpx;
}

.gauge-wrap {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 16rpx 0 24rpx;
  margin-bottom: 24rpx;
}

.gauge {
  width: 100%;
  height: 320rpx;
}

.readout {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 130rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
}

.value {
  font-size: 88rpx;
  font-weight: 500;
  color: #2c2c2a;
  line-height: 1;
}

.unit {
  font-size: 28rpx;
  color: #888780;
  margin-left: 8rpx;
}

.level {
  text-align: center;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.section {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 24rpx;
  color: #888780;
}

.wave {
  width: 100%;
  height: 140rpx;
  margin-top: 12rpx;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.stat {
  width: calc(50% - 12rpx);
  margin: 6rpx;
  background: #f1efe8;
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #888780;
  margin-bottom: 4rpx;
}

.stat-value {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #2c2c2a;
}

.meta {
  font-size: 24rpx;
  color: #5f5e5a;
  text-align: center;
  margin-bottom: 8rpx;
}

.disclaimer {
  font-size: 22rpx;
  color: #888780;
  text-align: center;
  margin-bottom: 24rpx;
}

.deny-card {
  background: #fcebeb;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.deny-title {
  font-size: 28rpx;
  color: #791f1f;
  font-weight: 500;
}

.deny-desc {
  font-size: 24rpx;
  color: #a32d2d;
  margin: 8rpx 0 16rpx;
}

.btn-small {
  height: 68rpx;
  font-size: 26rpx;
  padding: 0 40rpx;
}

.actions {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.btn-block {
  width: 100%;
}

.btn-half {
  width: 48%;
}

.btn-disabled {
  background: #f1efe8;
  color: #888780;
  border-color: #d3d1c7;
}

.tabbar {
  display: flex;
  border-top: 1rpx solid #d3d1c7;
  margin-top: 32rpx;
  padding-top: 16rpx;
}

.tab {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #888780;
  padding: 12rpx 0;
}

.tab-active {
  color: #185fa5;
  font-weight: 500;
}
